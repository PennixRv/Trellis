{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(?:clear|compact)$",
        "hooks": [
          {
            "type": "command",
            "command": "{{PYTHON_CMD}} -X utf8 .codex/hooks/inject-spec-context.py",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{PYTHON_CMD}} -X utf8 .codex/hooks/inject-workflow-state.py",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "{{PYTHON_CMD}} -X utf8 .codex/hooks/guard-teamwork-wait.py",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "{{PYTHON_CMD}} -X utf8 .codex/hooks/inject-spec-context.py",
            "timeout": 15,
            "additionalContextLimit": 0
          }
        ]
      }
    ]
  }
}
