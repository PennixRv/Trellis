{
  "name": "@pennixrv/trellis-paseo-adapter",
  "version": "0.7.2-beta.18",
  "description": "Optional local Paseo public SDK adapter for Trellis worktree delegation",
  "type": "module",
  "bin": {
    "trellis-paseo-adapter": "bin/adapter.js"
  },
  "files": [
    "bin",
    "src",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node --check bin/adapter.js && node --check src/adapter.js",
    "test": "node --test test/*.test.js",
    "lint": "node --check bin/adapter.js && node --check src/adapter.js",
    "typecheck": "node --check src/adapter.js"
  },
  "dependencies": {
    "@getpaseo/client": "0.15.3",
    "@getpaseo/server": "0.15.3"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/PennixRv/Trellis.git"
  }
